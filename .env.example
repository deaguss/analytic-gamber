GEMINI_API_KEY=
GPT2_API_URL=http://localhost:8000/predict
GEMINI_MODEL=gemini-2.5-flash
BATCH_SIZE=5
BATCH_DELAY=25  

# Threshold untuk rule-based classification
# HIGH_THRESHOLD: >= nilai ini = Judi Online (Default: 0.75)
# LOW_THRESHOLD: < nilai ini = Bukan Judi Online (Default: 0.50)
# Nilai diantara keduanya = Data Ambigu

HIGH_THRESHOLD=0.75
LOW_THRESHOLD=0.50

# ============================================================
# 2. OPENAI API CONFIGURATION (REQUIRED)
# ============================================================

# OpenAI API Key untuk GPT
# Cara mendapatkan:
# 1. Buka: https://platform.openai.com/api-keys
# 2. Login atau Sign Up
# 3. Klik "Create new secret key"
# 4. Copy API key dan paste di bawah
# 5. PENTING: Isi billing di https://platform.openai.com/account/billing

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
